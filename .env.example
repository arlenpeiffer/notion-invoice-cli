# Internal integration secret from https://www.notion.so/my-integrations
NOTION_ACCESS_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Data source ids — run `pnpm discover` to print these.
# These are data source ids, not database ids: dataSources.query takes the
# former, so storing them directly avoids a lookup call on every run.
CLIENTS_DATA_SOURCE_ID=
HOURS_DATA_SOURCE_ID=
INVOICES_DATA_SOURCE_ID=
PROJECTS_DATA_SOURCE_ID=
